---
import Page from "../layouts/Page.astro";
import { SEASON_ROSTER_SIZE } from "../../../src/season-roster.js";
import { competitionRoutes } from "../competition-view.js";

/**
 * One leaderboard per Competition, from the list the read API serves. A plain
 * segment and no longer a rest route: `/` is a redirect since ticket 6 of spec
 * 0017, so no route spells an empty segment and nothing needs one.
 */
export const getStaticPaths = competitionRoutes;

// `path` is this page's own, so the nav link marked as the current page is a
// link to it, `api` is the Competition's endpoint prefix, and
// `competitionName` is the league under the name the packet an Entrant reads
// names it. All three are the route's, spelled once in `competition-view.ts`,
// and this page holds no second copy of any of them (ADR-0039).
// `retiredLabel` is the frozen block's heading on the Competition that
// restarted and null on the ones that never did (ADR-0042), so it is what
// decides whether this page carries a block at all.
const { competition, competitionName, path, api, retiredLabel } = Astro.props;
---
<Page
  title={`${competitionName} leaderboard — Football Bench, match track`}
  current="leaderboard"
  competition={competition}
  competitionName={competitionName}
  competitionPath={path}
>
  {/*
    Everything below that is not a number is in the built HTML: the headings,
    the labels, the column headers and both explanations of what the ranking
    means. Only the figures wait on the fetch, so a reader sees the structure of
    the page before its data.
  */}
  <section class="hero">
    <div>
      <h1>One set of fixtures, one lock</h1>
      <p>
        Every Entrant sees the same context for every {competitionName} Fixture
        and commits a scoreline plus a probability distribution before the
        Gameweek deadline. Nothing is written after the Lock.
      </p>
    </div>
    <div class="soft stats">
      <div>
        <div class="stat-label">Season</div>
        <div class="stat-value" id="stat-season">&nbsp;</div>
      </div>
      <div>
        <div class="stat-label">Scored fixtures</div>
        <div class="stat-value" id="stat-settled">&nbsp;</div>
      </div>
      <div>
        <div class="stat-label">Through</div>
        <div class="stat-value" id="stat-through">&nbsp;</div>
      </div>
    </div>
  </section>

  <p class="error" id="error" hidden>
    The leaderboard could not be read. Nothing is being retried.
  </p>

  {/* The Competition the Season has not opened. Its own sentence, and not the
      panel below: that one promises a table that fills after the first
      Gameweek, which is a promise nobody has made about this league. The name
      is in the built HTML because it is the build's, like every other place
      this page says it.

      It wears `.preseason` and adds no CSS. The panel is a two-column grid and
      this state has one column of it to fill: there is no roster to list
      beside the sentence, because nothing has been entered. */}
  <section class="preseason" id="unopened" hidden>
    <div>
      <div class="kicker">Not open</div>
      <h2>{competitionName} has not opened</h2>
      <p>
        Nothing has been entered for it and no Gameweek of it is being scored.
        There is no date to wait for yet.
      </p>
    </div>
  </section>

  {/* The Season that has not been scored yet. Hidden until the response says
      so, which is `throughGw` being null and not an empty list of Entrants. */}
  <section class="preseason" id="preseason" hidden>
    <div>
      <div class="kicker">No result yet</div>
      <h2>The table fills after the first Gameweek is settled</h2>
      <p id="lock-note"></p>
    </div>
    <div class="soft entered">
      <div class="entered-title" id="entered-title">Entered</div>
      <div id="entered-rows"></div>
      <div class="entered-note">
        One Prompt Version, one context arm. Three Reference Lines run alongside
        and are never ranked.
      </div>
    </div>
  </section>

  <section id="ranking">
    <div class="rankbar">
      <h2>Ranking</h2>
      <span class="muted" id="sort-label">Sort by</span>
      {/* A radio group and not two buttons: it is one choice with two answers,
          and the design system styles exactly that. */}
      <div class="seg" role="group" aria-labelledby="sort-label">
        <label class="seg-opt">
          <input type="radio" name="sort" value="match" checked />
          Match points
        </label>
        <label class="seg-opt">
          <input type="radio" name="sort" value="bet" />
          Bet points
        </label>
      </div>
      <span class="ranknote muted" id="ranknote"></span>
    </div>

    <div class="lbbody" role="table" aria-label="Ranking">
      {/* The design's ruled list is four columns of divs, which reaches a
          screen reader as four unrelated runs of text. The roles put the table
          back without putting a `<table>` back: the layout is untouched and the
          column a figure sits under is announced with it. */}
      <div class="lbhead" role="row">
        <div role="columnheader">Rank</div>
        {/* Not "Entrant": an Exhibition Run is ranked in this column too, and
            says so on its own row. */}
        <div role="columnheader">Base Model</div>
        <div class="cell" role="columnheader">Match points</div>
        <div class="cell" role="columnheader">Bet points</div>
      </div>
      <div id="rows" role="rowgroup">
        {/* Still blocks over the same grid the real rows use. As many as the
            roster holds, read at build time from the one number that declares
            it: a loading state that guesses a different height moves the page
            when the data lands, and a height copied by hand goes stale the
            next time the roster moves. Fixed, not guessed -- the count is in
            the built HTML, not waiting on the fetch it is covering for. */}
        {Array.from({ length: SEASON_ROSTER_SIZE }).map(() => (
          <div class="lbrow lbrow-skeleton" aria-hidden="true">
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
          </div>
        ))}
      </div>
    </div>

    {/* Both qualifications at the length the scorer wrote them. The panel grows
        to fit the sentence; the sentence is never cut to fit the panel. */}
    <div class="qualifications">
      <p id="qual-match"></p>
      <p id="qual-bet"></p>
      {/* Empty unless the table holds an Exhibition Run, and never written from
          here: the sentence is the API's, beside the row that needs it. */}
      <p id="qual-exhibition"></p>
    </div>

    <div class="footnotes">
      <p>
        <strong>Match Points.</strong> 5 for an exact scoreline, 3 for the right
        goal difference, 2 for the right Outcome, 0 otherwise. Tiers are
        exclusive.
      </p>
      <p>
        <strong>Bet Points.</strong> One point per market that settles in the
        Entrant's favour, read off the committed scoreline: result, over/under
        2.5, 3.5 and 4.5, both teams to score.
      </p>
      <p>
        <strong>What this is not.</strong> Both columns rank; neither separates
        Base Models on its own. The evidential layer is the ranked probability
        score. Each Competition is its own benchmark: no ranking spans two, and
        a Base Model's place here says nothing about its place in another
        league.
      </p>
    </div>
  </section>

  {/* La Liga's Gameweek 1, played under the version the restart retired and
      kept whole rather than merged (ADR-0042). Emitted only where there is a
      retired Gameweek: the Premier League never used a version it has retired,
      and a block on its page would claim otherwise.

      Not hidden until the fetch lands, unlike the three states above. Those are
      three readings of one body and only one may be shown; this is a block that
      either belongs on the page or is not built into it, and its heading is the
      build's. A reader sees what the block is before its figures arrive, which
      is what the rest of this page does with everything that is not a number.

      Below the ranking and outside it, which is where it reads and not what
      keeps it out of the ranking: the leaderboard begins at Gameweek 2 because
      `rankedFrom` in the read API refuses the retired Gameweek to every figure
      the ranking is built from. A position on a page separates nothing. */}
  {retiredLabel !== null && (
    <section class="frozen" id="frozen">
      <div class="rankbar">
        <h2>{retiredLabel}</h2>
      </div>
      <p class="muted" id="frozen-scope"></p>

      <div class="lbbody" role="table" aria-label={retiredLabel}>
        {/* No rank column, because this is not a ranking: one Gameweek
            supports no claim, and a rank would make one. */}
        <div class="lbhead" role="row">
          <div role="columnheader">Base Model</div>
          <div class="cell" role="columnheader">Match points</div>
          <div class="cell" role="columnheader">Bet points</div>
          <div class="cell" role="columnheader">RPS</div>
        </div>
        <div id="frozen-rows" role="rowgroup"></div>
      </div>

      {/* Both stored sentences and the evidential one, at the length the
          scorer and ADR-0042 wrote them, above the line that speaks only when
          something is wrong. Every figure in the block is qualified by one of
          the three, which is what lets any of them be published (ADR-0012). */}
      <div class="qualifications">
        <p id="frozen-qual-match"></p>
        <p id="frozen-qual-bet"></p>
        <p id="frozen-caveat"></p>
        <p id="frozen-note"></p>
      </div>
    </section>
  )}

  {/* Inside the layout's document, not after it: a `<script>` written as a
      sibling of `<Page>` is emitted after `</html>`, which every browser
      repairs and no static artifact should need repairing.

      `define:vars` carries the endpoint this page reads, which is the
      Competition's and decided at build time. It implies `is:inline` and emits
      the same bytes without it -- the directive is written out because
      `astro check` asks for it in as many words, and a hint that never goes
      away is worse than an attribute that says something true. */}
  <script is:inline define:vars={{
    leaderboardUrl: `${api}/leaderboard`,
    // Null on a Competition with no retired Gameweek, which is the same
    // decision the block's markup was emitted on and read from the same prop —
    // so a page with no block cannot ask for one, and the endpoint that would
    // answer it 404s anyway.
    retiredUrl: retiredLabel === null ? null : `${api}/retired`
  }}>
  (() => {
    const $ = (id) => document.getElementById(id);
    const text = (node, value) => { node.textContent = value; };

    const SORTS = { match: "matchPoints", bet: "betPoints" };

    // The three states this page has, which are three sections and exactly one
    // of them at a time. The ids are the section ids, so the switch below and
    // the failure path both walk the same list.
    const STATES = ["unopened", "preseason", "ranking"];

    // The choice is in the URL so the link is copyable and a reload holds it,
    // and it is written with `replaceState` rather than `pushState`: sorting is
    // a view toggle, not navigation, and Back is expected to leave the page
    // rather than walk backwards through sort clicks.
    // `Object.hasOwn` and not `in`: `in` answers for everything on the
    // prototype too, so `?sort=toString` would be taken as a sort, order the
    // table by a method, and leave neither radio selected.
    const sortFromUrl = () => {
      const asked = new URL(location.href).searchParams.get("sort");
      return Object.hasOwn(SORTS, asked) ? asked : "match";
    };

    let sort = sortFromUrl();
    let body = null;

    for (const input of document.querySelectorAll('input[name="sort"]')) {
      input.checked = input.value === sort;
      input.addEventListener("change", () => {
        sort = input.value;
        const url = new URL(location.href);
        url.searchParams.set("sort", sort);
        history.replaceState(null, "", url);
        render();
      });
    }

    const seasonLabel = (season) => season.replace("-", "/");

    const lockLabel = (iso) =>
      new Date(iso).toLocaleString(undefined, {
        weekday: "long", day: "numeric", month: "long",
        hour: "2-digit", minute: "2-digit"
      });

    const div = (className, value, role) => {
      const node = document.createElement("div");
      node.className = className;
      if (value !== undefined) node.textContent = value;
      if (role !== undefined) node.role = role;
      return node;
    };

    const bar = (kind, value, max) => {
      const track = div("bar bar-" + kind);
      const fill = document.createElement("span");
      // Against the leader of that column, so a bar reads as the size of a gap.
      // A field of noughts has no leader and draws no fill rather than dividing
      // by zero.
      fill.style.width = (max > 0 ? (value / max) * 100 : 0) + "%";
      track.append(fill);
      return track;
    };

    const valueCell = (kind, value, max) => {
      const cell = div("cell", undefined, "cell");
      cell.append(div("lb-value", String(value)), bar(kind, value, max));
      return cell;
    };

    function renderRanking() {
      const key = SORTS[sort];
      const ranked = [...body.entrants].sort((a, b) => b[key] - a[key]);
      const most = (field) =>
        Math.max(0, ...body.entrants.map((entrant) => entrant[field]));
      const mostMatch = most("matchPoints");
      const mostBet = most("betPoints");

      const rows = document.createDocumentFragment();
      ranked.forEach((entrant, index) => {
        const row = div("lbrow", undefined, "row");
        const name = div("", undefined, "cell");
        name.append(
          div("lb-name", entrant.name),
          // The Base Model Class beside the id, so a reader knows whether they
          // are reading an Open-weight Base Model or a Frontier one.
          div("lb-id", [
            entrant.baseModelClass
              ? entrant.id + " · " + entrant.baseModelClass
              : entrant.id,
            // An Exhibition Run is ranked in the same table and says so on its
            // own row. The Gameweek is the API's, derived from when the run
            // answered, so the page states it and computes none of it.
            entrant.exhibition
              ? "ran after Gameweek " + entrant.exhibition.ranAfterGw
              : null
          ].filter(Boolean).join(" · "))
        );
        row.append(
          div("lb-rank", String(index + 1), "cell"),
          name,
          valueCell("match", entrant.matchPoints, mostMatch),
          valueCell("bet", entrant.betPoints, mostBet)
        );
        rows.append(row);
      });
      $("rows").replaceChildren(rows);

      // The Season's settled Fixtures and not any Entrant's own count: one
      // Entrant's Gap cannot move the figure the whole ranking is presented
      // against.
      text($("ranknote"),
        "n = " + body.settledFixtures + " fixtures · ranks, does not prove");
      text($("qual-match"), body.matchPointsQualification ?? "");
      text($("qual-bet"), body.betPointsQualification ?? "");
      text($("qual-exhibition"), body.exhibitionCaveat ?? "");
    }

    function renderPreSeason() {
      text($("entered-title"), "Entered for " + seasonLabel(body.season));
      text($("lock-note"), body.nextLock
        ? "Predictions for Gameweek " + body.nextLock.gw + " lock at the FPL "
          + "deadline on " + lockLabel(body.nextLock.deadlineAt)
          + ". Scoring runs after the last match of the round."
        : "Scoring runs after the last match of the round.");

      const rows = document.createDocumentFragment();
      for (const entrant of body.entrants) {
        const row = div("entered-row");
        row.append(div("entered-name", entrant.name), div("lb-id", entrant.id));
        rows.append(row);
      }
      $("entered-rows").replaceChildren(rows);
    }

    function render() {
      // Three states, named once. Which one it is decides what is shown, what
      // is drawn and what the hero says, and each of those reads the name
      // rather than asking the body again -- a second derivation is a fourth
      // state waiting to disagree with the first three.
      //
      // A Competition the Season has not opened reads as pre-season on every
      // other field in the body -- no scored Gameweek, no Entrant, no Lock --
      // so it is asked first, and asked of the one field that tells the two
      // apart.
      //
      // `=== false` and not `!body.active`. The edge holds a leaderboard for
      // five minutes and these pages deploy with the Worker, so the first five
      // minutes after this ships are bodies written before `active` existed --
      // and `!undefined` would draw "has not opened" over a scored Premier
      // League. A body without the field falls through to the `throughGw` test
      // below, which is the question it was answering when it was written.
      //
      // Null `throughGw` is the whole of the pre-season test. An empty list of
      // Entrants cannot tell a Season that has not started from a read that
      // returned nothing.
      const state = body.active === false ? "unopened"
        : body.throughGw === null ? "preseason"
        : "ranking";

      for (const id of STATES) $(id).hidden = id !== state;

      text($("stat-season"), seasonLabel(body.season));
      text($("stat-settled"), String(body.settledFixtures));
      text($("stat-through"),
        state === "ranking" ? "GW " + body.throughGw : "—");

      if (state === "preseason") renderPreSeason();
      if (state === "ranking") renderRanking();
    }

    function renderFrozen(frozen) {
      text($("frozen-scope"),
        "n = " + frozen.fixtures + " fixtures \u2014 the ones Gameweek "
        + frozen.gw + "'s Lock owned. Fixtures the calendar moved out of it "
        + "lock into a later Gameweek and are asked there, under the restarted "
        + "version.");

      // A stored figure or an em dash, and never a nought: the scorer writes
      // nothing at all for a Gameweek it has not scored, and a nought would
      // report that as a Gameweek every seat lost.
      const figure = (value, digits) =>
        value === null ? "\u2014" : Number(value).toFixed(digits);

      const rows = document.createDocumentFragment();
      for (const entrant of frozen.entrants) {
        const row = div("lbrow", undefined, "row");
        const name = div("", undefined, "cell");
        name.append(div("lb-name", entrant.name), div("lb-id", entrant.id));
        for (const [value, digits] of [
          [entrant.matchPoints, 0], [entrant.betPoints, 0], [entrant.rps, 3]
        ]) {
          const cell = div("cell", undefined, "cell");
          cell.append(div("lb-value", figure(value, digits)));
          row.append(cell);
        }
        row.prepend(name);
        rows.append(row);
      }
      $("frozen-rows").replaceChildren(rows);

      // The state where slice 1's scoring run never landed. It is said rather
      // than drawn around: this Gameweek was played, so an empty block is a
      // fault in the record and the page saying so is the only alarm a reader
      // gets.
      text($("frozen-qual-match"), frozen.matchPointsQualification ?? "");
      text($("frozen-qual-bet"), frozen.betPointsQualification ?? "");
      text($("frozen-caveat"), frozen.evidenceCaveat ?? "");

      // The body's own answer to whether anything was published, and not a
      // fourth derivation of it beside the three sentences it already decided.
      const scored = frozen.evidenceCaveat !== null;
      text($("frozen-note"), scored
        // Nothing, and deliberately: the line exists to say something is wrong,
        // and a block that read correctly has nothing to tell a reader that the
        // figures above it do not.
        ? ""
        : "This Gameweek was played and no scores are stored for it. The "
          + "record is incomplete \u2014 nothing here is being estimated, and "
          + "nothing is being retried.");
    }

    if (retiredUrl !== null) {
      fetch(retiredUrl)
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.json();
        })
        .then(renderFrozen)
        .catch(() => {
          // Its own line and not the page's: the leaderboard above may have
          // arrived, and one failed block must not report the whole page as
          // unread. The heading stays, so what a reader is told is that this
          // block could not be read rather than that it does not exist.
          text($("frozen-note"),
            "This block could not be read. Nothing is being retried.");
        });
    }

    // A relative path: the Worker route claims `/api/*` on this hostname, so
    // nothing is cross-origin and no origin was a build input. The Competition
    // is in the path and never defaulted, so `/pd` cannot read `/pl`'s rows.
    fetch(leaderboardUrl)
      .then((response) => {
        if (!response.ok) throw new Error(String(response.status));
        return response.json();
      })
      .then((json) => { body = json; render(); })
      .catch(() => {
        // One line, and nothing retries. Every state goes, from the same list
        // `render` switches over: a section added there and forgotten here
        // would sit under the error line saying something about a body that
        // never arrived.
        $("error").hidden = false;
        for (const id of STATES) $(id).hidden = true;
      });
  })();
  </script>
</Page>
