---
import type { ClosedEdition } from "../edition-note.js";

/**
 * What an earlier Edition's page opens with (ADR-0061): its label and the
 * frozen sentence. Rendered only on a closed Edition's routes, so the current
 * Edition's pages carry none of it, script included. Hidden until a body says
 * the Edition has ended: the constant can be deployed before the operator
 * inserts the next Edition, and until then the prefix answers the current one.
 *
 * `endpoint` is the league's leaderboard, read for its `edition`: the numbers
 * are the body's, never the build's. Null on `/overall`, whose own script
 * fills the note from the five bodies it already reads.
 */
interface Props {
  closed: ClosedEdition;
  endpoint: string | null;
}

const { closed, endpoint } = Astro.props;
---
<section
  class="edition-note"
  id="edition-note"
  data-endpoint={endpoint}
  data-number={closed.number}
  data-opened-by={closed.openedBy}
  hidden
>
  <div class="kicker" id="edition-label"></div>
  <p id="edition-sentence"></p>
</section>

<script>
  import { editionNote } from "../edition-note.js";

  const note = document.getElementById("edition-note")!;
  const { endpoint, number, openedBy } = note.dataset;
  // ponytail: a second read of the leaderboard the page may also fetch; the
  // edge caches it, and one shared fetch per page is the upgrade if it shows.
  if (endpoint !== undefined) {
    fetch(endpoint)
      .then((response) => response.ok ? response.json() : null)
      .then((body) => {
        const shown = body === null ? null : editionNote(
          body.edition, { number: Number(number), openedBy: openedBy! }
        );
        // Nothing while the Edition is still playing, and nothing on a failed
        // read: the page's own error line already says that.
        if (shown === null) return;
        document.getElementById("edition-label")!.textContent = shown.label;
        document.getElementById("edition-sentence")!.textContent = shown.sentence;
        note.hidden = false;
      })
      .catch(() => {});
  }
</script>
