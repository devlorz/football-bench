---
import {
  competitionRoutes, pageHref, type MatchPage
} from "../competition-view.js";

/**
 * The chrome every page of the dashboard wears: the sheets, the theme, the
 * header, the nav and the switcher. A page supplies its title, which nav link
 * it is, and the Competition it belongs to.
 *
 * The three nav links are the design's three pages, and all three point at this
 * Competition's copy of the page: a reader on La Liga stays on La Liga
 * whichever of them they click. The switcher is the other axis — same page,
 * other league.
 */
interface Props {
  title: string;
  current: MatchPage;
  /**
   * The league the page is reading, as the code the record is keyed by. It says
   * which switcher entry is the reader's own; the entries' names are the
   * switcher list's, so the chrome writes no league's name of its own.
   */
  competition: string;
  /**
   * The same league, named as the packet an Entrant reads names it — "La Liga"
   * and not the `PD` the record is keyed by. The page has it already and the
   * header states it.
   */
  competitionName: string;
  /**
   * The page's own Competition's path, which every link in the nav is built
   * from. A page marked as the current page must be a link to itself, and a
   * nav that sent a reader on La Liga to `/fixtures` would cross a league
   * without saying so.
   */
  competitionPath: string;
}

const { title, current, competition, competitionName, competitionPath } = Astro.props;

// Every served Competition, once each and under its own name, from the list
// the routes are built from: no league can be reachable by URL and missing
// from the header, or offered here and served by nothing.
const SWITCHER = competitionRoutes().map(({ props }) => props);

const LINKS = [
  { key: "leaderboard", label: "Leaderboard" },
  { key: "fixtures", label: "Fixtures" },
  // "Entrant record" and not the design's "Model stats": the glossary forbids
  // the second and spec 0011 renames the page.
  { key: "entrants", label: "Entrant record" },
  // Fourth link, built through the same `pageHref` as the other three. It
  // does not join the `.seg` switcher below: that switcher's answers come
  // from `SWITCHER` and are Competitions, and Overall is not one (spec 0025).
  { key: "overall", label: "Overall" }
] as const;

---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* Vendored whole and never edited, so the next version of the design
        system can be dropped over it; everything this site changes is in the
        second sheet. */}
    <link rel="stylesheet" href="/styles/modernist.css" />
    <link rel="stylesheet" href="/styles/overrides.css" />
    {/* Before the first paint and before the sheets have any say: a theme
        applied after render is a flash of the other one on every page load. */}
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") === "dark" ? "dark" : "light";
    </script>
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="nav-brand">
        <span class="brand-name">FOOTBALL BENCH</span>
        {/* The league in the header, so a tab among many tabs is identifiable
            and two identically laid-out leagues are told apart. The switcher
            below names it a second time, which reads as a repetition and is
            one: taking it out of here is a decision of ticket 1's, story 32's
            and ADR-0039's — the last of which refuses a colour per league on
            the ground that the header already names it — and not a side effect
            of adding a control. */}
        <span class="brand-track">{`Match track · ${competitionName}`}</span>
      </div>
      <nav class="navlinks" id="navlinks">
        {LINKS.map(({ key, label }) => (
          <a
            href={pageHref(competitionPath, key)}
            aria-current={key === current ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      {/* Same page, other league. Every entry is a real link and not a
          `<select>` or a `replaceState` control: crossing a Competition is
          navigation, and a reader who middle-clicks La Liga's Fixtures expects
          a tab of it. Built here rather than fetched, so it is in the HTML of
          every page the build emits and works before any script runs.

          It wears the Leaderboard's segmented control: `.seg` and `.seg-opt`
          draw the box and the dividers. Which segment is the chosen one is the
          rule `overrides.css` adds for it and argues there — the vendored
          sheet says it with `:has(input:checked)`, and a link holds no radio.
          It is `aria-current`, the same attribute the nav links above are
          marked with, so the league being read is announced and not only
          coloured.

          The league being read links to the page the reader is standing on,
          which is now that league's own path and nothing else: ticket 6 left
          every Competition exactly one URL per page, so `competitionPath` and
          this entry's `path` are the same string, and the substitution that
          stood here has nothing left to substitute. A link marked as the
          current page must point at the current page — the rule stated on
          `competitionPath` above — and it now holds by construction. */}
      <nav class="seg" aria-label="Competition">
        {SWITCHER.map(({ competition: code, path, competitionName }) => (
          <a
            class="seg-opt"
            href={pageHref(
              path,
              // Overall has no per-league copy for `pageHref` to hang the
              // crossing off (it ignores `path` entirely, spec 0025), so a
              // league picked from here falls back to that league's own
              // leaderboard rather than every entry linking to `/overall`
              // itself.
              current === "overall" ? "leaderboard" : current
            )}
            aria-current={code === competition ? "page" : undefined}
          >
            {competitionName}
          </a>
        ))}
      </nav>
      <div class="navtools">
        <button
          class="btn btn-ghost btn-icon burger"
          id="burger"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="navlinks"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"></path><path d="M3 12h18"></path><path d="M3 18h18"></path></svg>
        </button>
        <button
          class="btn btn-ghost btn-icon"
          id="theme"
          type="button"
          aria-label="Switch theme"
        >
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        </button>
      </div>
    </header>
    <main class="page">
      <slot />
    </main>

    <script is:inline>
      // The two controls in the chrome share no state with each other or with
      // anything on the page: each is local to the element it sits in.
      (() => {
        const root = document.documentElement;
        const nav = document.getElementById("nav");
        const burger = document.getElementById("burger");
        const theme = document.getElementById("theme");

        // The icon says which theme the click leads to, and the name has to say
        // the same thing: a control called "Switch theme" whatever it is about
        // to do leaves a reader who cannot see the icon with no way to tell
        // which theme they are in. Named here rather than in the markup so the
        // stored theme, which is only known once this runs, is what it reads.
        const name = () => {
          const label = root.dataset.theme === "dark"
            ? "Switch to light theme"
            : "Switch to dark theme";
          theme.setAttribute("aria-label", label);
          theme.title = label;
        };
        name();

        theme.addEventListener("click", () => {
          const dark = root.dataset.theme !== "dark";
          root.dataset.theme = dark ? "dark" : "light";
          // Held here rather than in the URL: the choice belongs to the reader
          // across every page and every visit, not to the link they copy.
          localStorage.setItem("theme", dark ? "dark" : "light");
          name();
        });

        const setMenu = (open) => {
          nav.classList.toggle("menu-open", open);
          burger.setAttribute("aria-expanded", String(open));
        };
        burger.addEventListener("click", () => {
          setMenu(!nav.classList.contains("menu-open"));
        });
        // Picking a link closes it, so nobody is left with a menu over the page
        // they asked for. The click still navigates.
        for (const link of document.querySelectorAll("#navlinks a")) {
          link.addEventListener("click", () => setMenu(false));
        }
      })();
    </script>
  </body>
</html>
